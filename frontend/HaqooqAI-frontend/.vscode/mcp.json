{
  "servers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn-ui-mcp-server"
      ],
      "env": {
        "NODE_ENV": "development"
      }
    },
    "shadcn-registry": {
      "command": "npx",
      "args": [
        "@magnusrodseth/shadcn-mcp-server"
      ],
      "env": {
        "NODE_ENV": "development"
      }
    },
    "kokonut-ui": {
      "command": "npx",
      "args": [
        "kokonut-ui-mcp-server"
      ],
      "env": {
        "NODE_ENV": "development"
      }
    },
    "motion-primitives": {
      "command": "npx",
      "args": [
        "motion-primitives@latest",
        "list"
      ],
      "env": {
        "NODE_ENV": "development",
        "MOTION_PRIMITIVES_CONFIG": "./motion-primitives.json"
      }
    },
    "mui": {
      "command": "npx",
      "args": [
        "@mui/mcp-server"
      ],
      "env": {
        "NODE_ENV": "development"
      }
    }
  }
}
