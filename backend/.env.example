# HaqooqAI Backend Environment Variables
# Copy this file to .env and fill in your actual values

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Usage Limits
USAGE_LIMIT_DEFAULT=5
MAX_QUERY_LENGTH=1000

# Groq API Configuration
DEFAULT_GROQ_KEY=your_groq_api_key_here

# Logging Configuration
LOG_LEVEL=INFO

# Optional: Custom ChromaDB settings
VECTOR_DB_DIR=./data/chroma_db
# COLLECTION_NAME=pakistan_laws
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Optional: Custom CORS origins (comma-separated)
# ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000

# Optional: Rate limiting
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=3600
